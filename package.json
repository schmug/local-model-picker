{
  "name": "local-model-picker",
  "private": true,
  "type": "module",
  "scripts": {
    "pick": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "build:web": "mkdir -p dist/web && cp web/index.html dist/web/",
    "build": "bun run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "bun run build:web && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "bun-types": "^1.4.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
